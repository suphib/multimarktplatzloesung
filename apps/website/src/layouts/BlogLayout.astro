---
import PageLayout from './PageLayout.astro';
import ArticleSchema from '../components/seo/ArticleSchema.astro';
import CTASection from '../components/astro/CTASection.astro';
import { FIRMA } from '../lib/constants';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description?: string;
  datum: string;
  autor: string;
  lesezeit: string;
}

const { title, description, datum, autor, lesezeit } = Astro.props;

const formatDatum = (d: string) => {
  return new Date(d).toLocaleDateString('de-DE', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};

const articleUrl = new URL(Astro.url.pathname, Astro.site).toString();

// Related posts (other blog posts, max 2)
const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter((p) => p.data.titel !== title)
  .sort((a, b) => new Date(b.data.datum).getTime() - new Date(a.data.datum).getTime())
  .slice(0, 2);

const breadcrumbItems = [
  { label: 'Startseite', href: '/' },
  { label: 'Blog', href: '/blog' },
  { label: title, href: Astro.url.pathname },
];
---

<PageLayout
  title={title}
  description={description}
  ogType="article"
  articlePublishedTime={datum}
  articleAuthor={autor}
  breadcrumbItems={breadcrumbItems}
>
  <article class="section-padding">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <header class="mb-8 lg:mb-12">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-gray-900 mb-4">
          {title}
        </h1>
        <div class="flex flex-wrap items-center gap-4 text-sm text-gray-500">
          <span>{formatDatum(datum)}</span>
          <span class="text-gray-300">|</span>
          <span>{autor}</span>
          <span class="text-gray-300">|</span>
          <span>{lesezeit} Lesezeit</span>
        </div>
      </header>

      <!-- Content -->
      <div class="prose prose-lg prose-primary max-w-none
        prose-headings:font-bold prose-headings:text-gray-900
        prose-p:text-gray-600 prose-p:leading-relaxed
        prose-a:text-primary-600 prose-a:no-underline hover:prose-a:underline
        prose-img:rounded-xl prose-img:shadow-lg">
        <slot />
      </div>
    </div>
  </article>
  <!-- Related Posts -->
  {relatedPosts.length > 0 && (
    <section class="border-t border-gray-100 py-12">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-xl font-bold text-gray-900 mb-6">Weiterlesen</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {relatedPosts.map((post) => (
            <a href={`/blog/${post.id}`} class="group block p-5 rounded-xl border border-gray-200 hover:border-primary-200 hover:shadow-md transition-all">
              <h3 class="font-semibold text-gray-900 group-hover:text-primary-600 transition-colors mb-2">{post.data.titel}</h3>
              <p class="text-sm text-gray-500 line-clamp-2">{post.data.beschreibung}</p>
              <span class="inline-block mt-3 text-sm text-primary-600 font-medium">Lesen →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <CTASection titel="Überzeugt?" beschreibung="Fordern Sie jetzt Ihre kostenlose Demo an und erleben Sie procurement-ai in Aktion." />

  <ArticleSchema
    titel={title}
    beschreibung={description || ''}
    datum={datum}
    autor={autor}
    url={articleUrl}
  />
</PageLayout>
