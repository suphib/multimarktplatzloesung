---
import PageLayout from '../layouts/PageLayout.astro';
import CTASection from '../components/astro/CTASection.astro';
import SectionHeading from '../components/astro/SectionHeading.astro';
import { TRUST_METRICS } from '../lib/constants';
---

<PageLayout title="Referenzen & Vertrauen" description="Warum öffentliche Auftraggeber procurement-ai vertrauen: DSGVO-konform, gehostet in Deutschland, vergaberechtskonform, EU KI-Verordnung konform.">

  <!-- Hero -->
  <section class="gradient-hero text-white py-12 sm:py-16 lg:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold">Referenzen & Vertrauen</h1>
      <p class="mt-4 text-base sm:text-lg text-blue-100 max-w-2xl mx-auto">
        Warum öffentliche Auftraggeber und regulierte Industrien auf procurement-ai setzen.
      </p>
    </div>
  </section>

  <!-- Trust Metrics -->
  <section class="section-padding">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
        {TRUST_METRICS.map((metric) => (
          <div class="text-center">
            <div class="text-3xl sm:text-4xl font-extrabold text-primary-600">
              {metric.prefix}{metric.wert}{metric.suffix}
            </div>
            <div class="text-sm text-gray-500 mt-1">{metric.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Warum procurement-ai -->
  <section class="section-padding bg-gray-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading titel="Warum procurement-ai?" untertitel="Vertrauen durch Transparenz und Technologie" />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { titel: 'Made in Germany', beschreibung: 'Entwickelt und betrieben in Deutschland. Alle Server stehen in deutschen Rechenzentren bei 24fire GmbH.', icon: 'M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm0 0h9' },
          { titel: '100% DSGVO-konform', beschreibung: 'Auftragsverarbeitungsverträge mit allen Dienstleistern. Keine Datenübertragung in Drittländer.', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' },
          { titel: 'EU KI-Verordnung konform', beschreibung: 'Transparenz über KI-Einsatz gemäß Art. 50 EU KI-VO. Kein Training mit Kundendaten. Menschliche Kontrolle garantiert.', icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
          { titel: 'Vergaberechtskonform', beschreibung: 'Automatische CPV-Klassifizierung, Schwellenwertprüfung und revisionssichere Dokumentation nach UVgO/VgV.', icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
          { titel: 'SHA-256 Audit-Trail', beschreibung: 'Manipulationssichere Dokumentation mit kryptografischer Integritätsprüfung. Jeder Vorgang ist nachvollziehbar.', icon: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z' },
          { titel: 'Datenportabilität', beschreibung: 'Kein Vendor Lock-in. Vollständiger Datenexport in JSON/CSV jederzeit möglich. 30 Tage Export nach Vertragsende.', icon: 'M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4' },
        ].map((item) => (
          <div class="bg-white rounded-xl border border-gray-200 p-6">
            <div class="w-10 h-10 rounded-lg bg-primary-50 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d={item.icon} />
              </svg>
            </div>
            <h3 class="font-semibold text-gray-900 mb-2">{item.titel}</h3>
            <p class="text-sm text-gray-600">{item.beschreibung}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Betreiber -->
  <section class="section-padding">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-6">Ein Produkt der WP Workers GmbH</h2>
      <p class="text-gray-600 leading-relaxed mb-8">
        procurement-ai wird von der <strong>WP Workers GmbH</strong> entwickelt und betrieben —
        einem deutschen Softwareunternehmen mit Sitz in Eichenau bei München. Wir entwickeln
        KI-gestützte SaaS-Lösungen für den B2B-Bereich mit Fokus auf Datenschutz und Compliance.
      </p>
      <a href="/ueber-uns" class="inline-flex items-center gap-2 text-primary-600 font-semibold hover:underline">
        Mehr über uns erfahren →
      </a>
    </div>
  </section>

  <CTASection titel="Werden Sie Teil unserer Referenzen" beschreibung="Starten Sie mit procurement-ai und erleben Sie vergaberechtskonforme Beschaffung mit KI-Unterstützung. 30 Tage kostenlos." />
</PageLayout>
