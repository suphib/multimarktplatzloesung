---
import PageLayout from '../layouts/PageLayout.astro';

const glossar = [
  { begriff: 'AVV', erklaerung: 'Auftragsverarbeitungsvertrag. Vertrag nach Art. 28 DSGVO zwischen dem Verantwortlichen und dem Auftragsverarbeiter, der die Datenverarbeitung regelt.', links: ['/datenschutz'] },
  { begriff: 'Bedarfsermittlung', erklaerung: 'Erster Schritt im Beschaffungsprozess. Feststellung von Art, Menge und Zeitpunkt des benötigten Bedarfs an Gütern oder Dienstleistungen.', links: ['/vergaberecht'] },
  { begriff: 'CPV-Code', erklaerung: 'Common Procurement Vocabulary. EU-weites Klassifizierungssystem für öffentliche Aufträge. Jeder Code besteht aus 8 Ziffern und einer Prüfziffer (z. B. 30213300-8 für Desktop-Computer).', links: ['/cpv-klassifizierung'] },
  { begriff: 'cXML', erklaerung: 'Commerce XML. Offener Standard für B2B-E-Commerce-Transaktionen, entwickelt von Ariba/SAP. Wird für Punchout-Kataloge und elektronische Bestellungen verwendet.', links: ['/oci-integration'] },
  { begriff: 'DSGVO', erklaerung: 'Datenschutz-Grundverordnung. EU-Verordnung 2016/679 zum Schutz natürlicher Personen bei der Verarbeitung personenbezogener Daten.', links: ['/sicherheit', '/datenschutz'] },
  { begriff: 'eVergabe', erklaerung: 'Elektronische Vergabe. Durchführung von Vergabeverfahren in elektronischer Form, einschließlich Bekanntmachung, Angebotsabgabe und Zuschlag.', links: ['/vergaberecht'] },
  { begriff: 'Genehmigungsworkflow', erklaerung: 'Digitaler Freigabeprozess für Bestellungen. In procurement-ai werden Bestellungen über konfigurierbare Schwellenwerte automatisch zur Genehmigung vorgelegt.', links: ['/features'] },
  { begriff: 'GWB', erklaerung: 'Gesetz gegen Wettbewerbsbeschränkungen. Teil 4 regelt die Vergabe öffentlicher Aufträge oberhalb der EU-Schwellenwerte.', links: ['/vergaberecht'] },
  { begriff: 'Konfidenz', erklaerung: 'Vertrauensgrad einer KI-Klassifizierung. Gibt an, wie sicher die KI bei der CPV-Zuordnung ist. Bei niedriger Konfidenz wird ein Fallback-System aktiviert.', links: ['/cpv-klassifizierung'] },
  { begriff: 'Mindestbestellwert', erklaerung: 'Minimaler Bestellwert, ab dem eine Bestellung bei einem Lieferanten oder über einen Rahmenvertrag möglich ist.', links: [] },
  { begriff: 'OCI 5.0', erklaerung: 'Open Catalog Interface Version 5.0. Von SAP entwickelter Standard für die Integration externer Kataloge in ERP-Systeme über Punchout-Mechanismen.', links: ['/oci-integration'] },
  { begriff: 'Punchout', erklaerung: 'Prozess, bei dem ein Nutzer aus dem ERP-System heraus auf einen externen Katalog zugreift, dort Artikel auswählt und den Warenkorb zurück ins ERP überträgt.', links: ['/oci-integration'] },
  { begriff: 'Rahmenvertrag', erklaerung: 'Langfristiger Vertrag zwischen Auftraggeber und Lieferant, der Konditionen (Preise, Skonto, Lieferzeiten) für wiederkehrende Bestellungen festlegt.', links: ['/features'] },
  { begriff: 'Schwellenwert', erklaerung: 'Auftragswert, ab dem bestimmte Vergabevorschriften gelten. Unterhalb des nationalen Schwellenwerts gilt die UVgO, oberhalb des EU-Schwellenwerts die VgV.', links: ['/vergaberecht'] },
  { begriff: 'SHA-256', erklaerung: 'Kryptografischer Hash-Algorithmus. Wird in procurement-ai zur Integritätsprüfung der Vergabedokumentation eingesetzt. Jede Änderung am Dokument erzeugt einen neuen Hash.', links: ['/sicherheit'] },
  { begriff: 'Skonto', erklaerung: 'Preisnachlass bei Zahlung innerhalb einer bestimmten Frist. In procurement-ai werden Skonto-Konditionen aus Rahmenverträgen automatisch berechnet.', links: [] },
  { begriff: 'TED', erklaerung: 'Tenders Electronic Daily. Online-Supplement zum Amtsblatt der EU, in dem alle EU-weiten Ausschreibungen veröffentlicht werden.', links: ['/vergaberecht'] },
  { begriff: 'UVgO', erklaerung: 'Unterschwellenvergabeordnung. Regelt die Vergabe von Liefer- und Dienstleistungsaufträgen unterhalb der EU-Schwellenwerte.', links: ['/vergaberecht'] },
  { begriff: 'Vergabedokumentation', erklaerung: 'Lückenlose Dokumentation des gesamten Beschaffungsprozesses — von der Bedarfsermittlung bis zum Vertragsschluss. Muss revisionssicher und nachvollziehbar sein.', links: ['/vergaberecht', '/sicherheit'] },
  { begriff: 'VgV', erklaerung: 'Vergabeverordnung. Regelt die Vergabe von Liefer- und Dienstleistungsaufträgen oberhalb der EU-Schwellenwerte.', links: ['/vergaberecht'] },
];

const buchstaben = [...new Set(glossar.map(g => g.begriff[0].toUpperCase()))].sort();
---

<PageLayout title="Beschaffungs-Glossar" description="Glossar für öffentliche Beschaffung: CPV-Codes, OCI 5.0, Vergaberecht, DSGVO und alle wichtigen Fachbegriffe verständlich erklärt.">

  <!-- Hero -->
  <section class="gradient-hero text-white py-12 sm:py-16 lg:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold">Beschaffungs-Glossar</h1>
      <p class="mt-4 text-base sm:text-lg text-blue-100 max-w-2xl mx-auto">
        Alle wichtigen Fachbegriffe rund um öffentliche Beschaffung, Vergaberecht und eProcurement — verständlich erklärt.
      </p>
    </div>
  </section>

  <!-- Buchstaben-Navigation -->
  <section class="sticky top-0 z-10 bg-white border-b border-gray-200 py-3">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap gap-2 justify-center">
        {buchstaben.map((b) => (
          <a href={`#${b}`} class="w-8 h-8 rounded-lg bg-gray-100 hover:bg-primary-100 hover:text-primary-700 flex items-center justify-center text-sm font-medium text-gray-700 transition-colors">{b}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- Glossar-Einträge -->
  <section class="section-padding">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      {buchstaben.map((buchstabe) => (
        <div id={buchstabe} class="mb-8">
          <h2 class="text-2xl font-extrabold text-gray-900 mb-4 border-b border-gray-200 pb-2">{buchstabe}</h2>
          <div class="space-y-6">
            {glossar.filter(g => g.begriff[0].toUpperCase() === buchstabe).map((eintrag) => (
              <div>
                <h3 class="text-lg font-bold text-gray-900 mb-1">{eintrag.begriff}</h3>
                <p class="text-gray-600 text-sm leading-relaxed">{eintrag.erklaerung}</p>
                {eintrag.links.length > 0 && (
                  <div class="flex flex-wrap gap-2 mt-2">
                    {eintrag.links.map((link) => (
                      <a href={link} class="inline-flex items-center gap-1 text-xs text-primary-600 hover:underline">
                        Mehr erfahren →
                      </a>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</PageLayout>
