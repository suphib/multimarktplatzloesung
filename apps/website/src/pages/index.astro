---
import PageLayout from '../layouts/PageLayout.astro';
import HeroSection from '../components/astro/HeroSection.astro';
import TrustMetrics from '../components/astro/TrustMetrics.astro';
import FeatureGrid from '../components/astro/FeatureGrid.astro';
import IntegrationGrid from '../components/astro/IntegrationGrid.astro';
import CTASection from '../components/astro/CTASection.astro';
import SectionHeading from '../components/astro/SectionHeading.astro';
import Screenshot from '../components/astro/Screenshot.astro';
import OrganizationSchema from '../components/seo/OrganizationSchema.astro';
import SoftwareApplicationSchema from '../components/seo/SoftwareApplicationSchema.astro';

const vpGallery = ['admin-bestellung-detail', 'admin-rahmenvertraege', 'results'];
const vpGalleryAlts = ['Bestellungsdetail mit Genehmigungs-Timeline', 'Rahmenverträge-Verwaltung', 'Multi-Marktplatz Suchergebnisse'];
---

<PageLayout title="Startseite">
  <HeroSection />
  <TrustMetrics />
  <FeatureGrid max={3} />
  <IntegrationGrid />

  <!-- Value Props: alternierend Bild+Text -->
  <section class="section-padding">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16 lg:space-y-24">

      <!-- VP 1: Vergaberecht -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
        <div class="order-2 lg:order-1">
          <h3 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4">
            Vergaberechtskonform auf Knopfdruck
          </h3>
          <p class="text-gray-600 leading-relaxed mb-4">
            Automatische Prüfung gegen EU-Schwellenwerte und nationale Vergabevorschriften.
            Jeder Beschaffungsvorgang wird lückenlos dokumentiert und mit SHA-256 Hash gesichert.
          </p>
          <ul class="space-y-2">
            <li class="flex items-center gap-2 text-sm text-gray-600">
              <svg class="w-5 h-5 text-green-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              EU-Schwellenwerte automatisch geprüft
            </li>
            <li class="flex items-center gap-2 text-sm text-gray-600">
              <svg class="w-5 h-5 text-green-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Revisionssichere Dokumentation
            </li>
            <li class="flex items-center gap-2 text-sm text-gray-600">
              <svg class="w-5 h-5 text-green-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              CPV-Code Klassifizierung
            </li>
          </ul>
        </div>
        <div class="order-1 lg:order-2">
          <Screenshot name="admin-bestellung-detail" alt="Bestellungsdetail mit Genehmigungs-Timeline" gallery={vpGallery} galleryAlts={vpGalleryAlts} />
        </div>
      </div>

      <!-- VP 2: Rahmenverträge -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
        <Screenshot name="admin-rahmenvertraege" alt="Rahmenverträge-Verwaltung" gallery={vpGallery} galleryAlts={vpGalleryAlts} />
        <div>
          <h3 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4">
            Rahmenverträge intelligent nutzen
          </h3>
          <p class="text-gray-600 leading-relaxed mb-4">
            Automatischer Abgleich Ihrer Bedarfe mit bestehenden Rahmenverträgen.
            Skonto-Konditionen, Mindestbestellwerte und Abrufvolumen immer im Blick.
          </p>
          <ul class="space-y-2">
            <li class="flex items-center gap-2 text-sm text-gray-600">
              <svg class="w-5 h-5 text-green-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Automatisches RV-Matching
            </li>
            <li class="flex items-center gap-2 text-sm text-gray-600">
              <svg class="w-5 h-5 text-green-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Skonto automatisch berechnet
            </li>
            <li class="flex items-center gap-2 text-sm text-gray-600">
              <svg class="w-5 h-5 text-green-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Laufzeit-Überwachung
            </li>
          </ul>
        </div>
      </div>

      <!-- VP 3: Multi-Marktplatz -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
        <div class="order-2 lg:order-1">
          <h3 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4">
            Ein Zugang, alle Marktplätze
          </h3>
          <p class="text-gray-600 leading-relaxed mb-4">
            Durchsuchen Sie Amazon Business, Mercateo, Conrad und weitere Marktplätze gleichzeitig.
            Vergleichen Sie Preise, Lieferzeiten und Konditionen auf einen Blick.
          </p>
          <ul class="space-y-2">
            <li class="flex items-center gap-2 text-sm text-gray-600">
              <svg class="w-5 h-5 text-green-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Parallele Marktplatzsuche
            </li>
            <li class="flex items-center gap-2 text-sm text-gray-600">
              <svg class="w-5 h-5 text-green-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Preisvergleich in Echtzeit
            </li>
            <li class="flex items-center gap-2 text-sm text-gray-600">
              <svg class="w-5 h-5 text-green-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Direkte Bestellung aus der Plattform
            </li>
          </ul>
        </div>
        <div class="order-1 lg:order-2">
          <Screenshot name="results" alt="Multi-Marktplatz Suchergebnisse" gallery={vpGallery} galleryAlts={vpGalleryAlts} />
        </div>
      </div>
    </div>
  </section>

  <CTASection />
  <OrganizationSchema />
  <SoftwareApplicationSchema />
</PageLayout>
