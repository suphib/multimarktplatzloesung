---
import PageLayout from '../layouts/PageLayout.astro';
import CTASection from '../components/astro/CTASection.astro';
import SectionHeading from '../components/astro/SectionHeading.astro';
import { ERP_LOGOS } from '../lib/constants';
---

<PageLayout title="OCI 5.0 & cXML Integration" description="procurement-ai nahtlos in Ihr ERP-System integrieren: OCI 5.0, cXML Punchout, REST API. SAP, Microsoft Dynamics, Oracle und weitere Systeme unterstützt.">

  <!-- Hero -->
  <section class="gradient-hero text-white py-12 sm:py-16 lg:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-blue-100 text-xs font-semibold mb-4">
        ERP-Integration
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold">OCI 5.0 & cXML Integration</h1>
      <p class="mt-4 text-base sm:text-lg text-blue-100 max-w-2xl mx-auto">
        Nahtlose Anbindung an Ihr ERP-System — ohne Medienbruch, ohne Doppelerfassung.
      </p>
    </div>
  </section>

  <!-- Was ist OCI -->
  <section class="section-padding">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-6">Was ist OCI 5.0?</h2>
      <p class="text-gray-600 leading-relaxed mb-4">
        <strong>OCI (Open Catalog Interface)</strong> ist ein von SAP entwickelter Standard für die
        Integration externer Kataloge in ERP-Systeme. Version 5.0 ermöglicht den direkten Zugriff
        auf externe Beschaffungskataloge aus dem ERP-System heraus — der sogenannte „Punchout"-Prozess.
      </p>
      <p class="text-gray-600 leading-relaxed">
        <strong>cXML (Commerce XML)</strong> ist ein offener Standard für B2B-Transaktionen, der
        von Ariba/SAP entwickelt wurde. Er ermöglicht den automatisierten Austausch von Bestellungen,
        Auftragsbestätigungen und Rechnungen zwischen Systemen.
      </p>
    </div>
  </section>

  <!-- So funktioniert es -->
  <section class="section-padding bg-gray-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading titel="So funktioniert die Integration" untertitel="Vom ERP-System zum Warenkorb in 4 Schritten" />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { schritt: '1', titel: 'Punchout starten', beschreibung: 'Nutzer startet aus dem ERP-System heraus eine Bestellung und wird automatisch zu procurement-ai weitergeleitet.' },
          { schritt: '2', titel: 'Artikel suchen', beschreibung: 'KI-gestützte Suche über alle angebundenen Marktplätze. CPV-Klassifizierung und Preisvergleich inklusive.' },
          { schritt: '3', titel: 'Warenkorb füllen', beschreibung: 'Gewünschte Artikel werden in den Warenkorb gelegt. Rahmenverträge und Skonto werden automatisch berücksichtigt.' },
          { schritt: '4', titel: 'Zurück ins ERP', beschreibung: 'Der Warenkorb wird per OCI/cXML direkt ins ERP-System übertragen. Keine manuelle Eingabe nötig.' },
        ].map((item) => (
          <div class="bg-white rounded-xl border border-gray-200 p-6">
            <div class="w-8 h-8 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold mb-4">{item.schritt}</div>
            <h3 class="font-semibold text-gray-900 mb-2">{item.titel}</h3>
            <p class="text-sm text-gray-600">{item.beschreibung}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Unterstützte ERP-Systeme -->
  <section class="section-padding">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading titel="Unterstützte ERP-Systeme" untertitel="Integration über standardisierte Schnittstellen" />

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
        {ERP_LOGOS.map((erp) => (
          <div class="bg-white rounded-xl border border-gray-200 p-4 flex flex-col items-center text-center hover:shadow-md transition-shadow">
            <img src={`/erp-logos/${erp.datei}`} alt={erp.name} class="h-10 w-auto mb-3" loading="lazy" />
            <span class="text-sm font-medium text-gray-900">{erp.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Technische Spezifikationen -->
  <section class="section-padding bg-gray-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading titel="Technische Spezifikationen" />
      <div class="bg-white rounded-2xl border border-gray-200 divide-y divide-gray-100">
        {[
          ['Protokolle', 'OCI 5.0, cXML 1.2, REST API'],
          ['Authentifizierung', 'OAuth 2.0, API-Key, SSO (SAML 2.0)'],
          ['Datenformate', 'JSON, XML, CSV'],
          ['Warenkorb-Übergabe', 'OCI Punchout / cXML PunchOutOrderMessage'],
          ['Bestellübertragung', 'cXML OrderRequest / OCI HOOK_URL'],
          ['Verschlüsselung', 'TLS 1.3, AES-256'],
          ['Dokumentation', 'OpenAPI 3.0 Spezifikation'],
          ['Sandbox', 'Vollständige Testumgebung verfügbar'],
        ].map(([label, value]) => (
          <div class="flex flex-col sm:flex-row sm:items-center justify-between p-4 sm:p-5 gap-1">
            <span class="text-sm font-medium text-gray-900">{label}</span>
            <span class="text-sm text-gray-500">{value}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Vorteile -->
  <section class="section-padding">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading titel="Vorteile der ERP-Integration" />

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {[
          { titel: 'Kein Medienbruch', beschreibung: 'Direkte Warenkorb-Übernahme ins ERP. Keine manuelle Datenerfassung, keine Fehlerquellen.' },
          { titel: 'Prozessautomatisierung', beschreibung: 'Genehmigungsworkflows, Kontierung und Budgetprüfung erfolgen automatisch im ERP-System.' },
          { titel: 'Schnelle Einrichtung', beschreibung: 'Standard-Schnittstellen ermöglichen die Integration in 2-4 Wochen. Sandbox zum Testen verfügbar.' },
        ].map((vorteil) => (
          <div class="bg-white rounded-xl border border-gray-200 p-6 text-center">
            <h3 class="font-semibold text-gray-900 mb-2">{vorteil.titel}</h3>
            <p class="text-sm text-gray-600">{vorteil.beschreibung}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection titel="Integration starten" beschreibung="Lassen Sie sich von unserem Team beraten, wie procurement-ai in Ihr ERP-System integriert wird. Kostenlose technische Beratung." />
</PageLayout>
