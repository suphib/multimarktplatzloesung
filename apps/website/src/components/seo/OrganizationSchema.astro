---
import JsonLd from './JsonLd.astro';
import { FIRMA } from '../../lib/constants';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: FIRMA.name,
  legalName: FIRMA.betreiber,
  url: FIRMA.website,
  logo: `${FIRMA.website}/images/logo.svg`,
  email: FIRMA.email,
  telephone: FIRMA.telefon,
  address: {
    '@type': 'PostalAddress',
    streetAddress: FIRMA.strasse,
    addressLocality: FIRMA.ort,
    postalCode: FIRMA.plz,
    addressCountry: 'DE',
  },
};
---

<JsonLd schema={schema} />
