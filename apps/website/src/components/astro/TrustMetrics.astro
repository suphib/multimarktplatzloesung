---
import AnimatedCounter from '../react/AnimatedCounter';
import { TRUST_METRICS } from '../../lib/constants';
---

<section class="py-8 sm:py-12 bg-white border-y border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
      {TRUST_METRICS.map((metric) => (
        <div class="text-center">
          <div class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-primary-600">
            <AnimatedCounter
              client:visible
              zielwert={metric.wert}
              suffix={metric.suffix}
              prefix={metric.prefix}
            />
          </div>
          <p class="mt-1 sm:mt-2 text-xs sm:text-sm text-gray-500">{metric.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
