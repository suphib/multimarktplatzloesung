---
interface Props {
  titel?: string;
  beschreibung?: string;
  ctaText?: string;
  ctaHref?: string;
}

const {
  titel = 'Bereit für effizientere Beschaffung?',
  beschreibung = 'Vereinbaren Sie eine kostenlose Demo und erleben Sie, wie procurement-ai Ihre Beschaffungsprozesse revolutioniert.',
  ctaText = 'Kostenlose Demo anfordern',
  ctaHref = '/kontakt/',
} = Astro.props;
---

<section class="gradient-primary text-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-20 text-center">
    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold">
      {titel}
    </h2>
    <p class="mt-3 sm:mt-4 text-base sm:text-lg text-blue-100 max-w-2xl mx-auto">
      {beschreibung}
    </p>
    <div class="mt-6 sm:mt-8">
      <a
        href={ctaHref}
        class="inline-flex items-center justify-center px-6 py-3 sm:px-8 sm:py-4 rounded-lg bg-white text-primary-700 font-semibold text-sm sm:text-base hover:bg-gray-50 transition-colors shadow-lg"
      >
        {ctaText}
      </a>
    </div>
  </div>
</section>
