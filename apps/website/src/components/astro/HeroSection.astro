---
---
<section class="relative overflow-hidden gradient-hero text-white">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 25% 50%, rgba(255,255,255,0.15) 0%, transparent 50%), radial-gradient(circle at 75% 50%, rgba(255,255,255,0.1) 0%, transparent 50%);"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 lg:py-28">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
      <!-- Text Content - Mobile First -->
      <div class="text-center lg:text-left">
        <h1 class="text-2xl sm:text-4xl lg:text-5xl xl:text-6xl font-extrabold leading-tight tracking-tight">
          Intelligente Beschaffung für den öffentlichen Sektor &amp; regulierte Industrien.
        </h1>
        <p class="mt-4 sm:mt-6 text-base sm:text-lg lg:text-xl text-blue-100 max-w-xl mx-auto lg:mx-0 leading-relaxed">
          Automatisieren Sie Ihre Beschaffungsprozesse mit künstlicher Intelligenz.
          DSGVO-konform, vergaberechtskonform und nahtlos in Ihr ERP integrierbar.
        </p>

        <!-- CTAs -->
        <div class="mt-6 sm:mt-8 flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center lg:justify-start">
          <a
            href="/kontakt"
            class="inline-flex items-center justify-center px-6 py-3 sm:px-8 sm:py-4 rounded-lg bg-white text-primary-700 font-semibold text-sm sm:text-base hover:bg-gray-50 transition-colors shadow-lg"
          >
            Kostenlose Demo anfordern
          </a>
          <a
            href="/features"
            class="inline-flex items-center justify-center px-6 py-3 sm:px-8 sm:py-4 rounded-lg border-2 border-white/30 text-white font-semibold text-sm sm:text-base hover:bg-white/10 transition-colors"
          >
            Features entdecken
          </a>
        </div>
      </div>

      <!-- Browser Mockup -->
      <div class="hidden sm:block">
        <div class="relative mx-auto max-w-lg lg:max-w-none">
          <!-- Browser Frame -->
          <div class="bg-gray-800 rounded-t-xl p-3">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-red-400"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
              <div class="w-3 h-3 rounded-full bg-green-400"></div>
              <div class="ml-4 flex-1 bg-gray-700 rounded-md px-3 py-1">
                <span class="text-xs text-gray-400">app.procurement-ai.de</span>
              </div>
            </div>
          </div>
          <button
            type="button"
            class="hero-screenshot-btn relative block w-full bg-white rounded-b-xl shadow-2xl overflow-hidden cursor-zoom-in group text-left"
            aria-label="Screenshot vergrößern"
          >
            <img
              src="/images/screenshots/desktop/search.png"
              alt="procurement-ai Suchoberfläche"
              class="w-full h-auto"
            />
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/5 transition-colors rounded-b-xl"></div>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelector('.hero-screenshot-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('lightbox:open', {
      detail: {
        screenshots: [{ src: '/images/screenshots/desktop/search.png', alt: 'procurement-ai Suchoberfläche' }],
        index: 0,
      },
    }));
  });
</script>
