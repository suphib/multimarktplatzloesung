---
interface Props {
  titel: string;
  beschreibung: string;
  datum: string;
  slug: string;
  lesezeit: string;
  bild?: string;
  tags?: string[];
}

const { titel, beschreibung, datum, slug, lesezeit, bild, tags } = Astro.props;

const formatDatum = (d: string) => {
  return new Date(d).toLocaleDateString('de-DE', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};
---

<article class="group bg-white rounded-2xl border border-gray-100 overflow-hidden hover:shadow-xl hover:border-primary-200 transition-all duration-300">
  <!-- Hero Image -->
  <a href={`/blog/${slug}`} class="block overflow-hidden">
    {bild ? (
      <div class="aspect-[16/9] overflow-hidden">
        <img
          src={bild}
          alt={titel}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
        />
      </div>
    ) : (
      <div class="aspect-[16/9] bg-gradient-to-br from-primary-50 to-primary-100 flex items-center justify-center">
        <svg class="w-12 h-12 text-primary-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
        </svg>
      </div>
    )}
  </a>

  <div class="p-5 sm:p-6">
    <!-- Tags -->
    {tags && tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-3">
        {tags.slice(0, 3).map((tag) => (
          <span class="px-2.5 py-0.5 text-xs font-medium bg-primary-50 text-primary-700 rounded-full">
            {tag}
          </span>
        ))}
      </div>
    )}

    <div class="flex items-center gap-3 text-xs text-gray-500 mb-3">
      <time datetime={datum}>{formatDatum(datum)}</time>
      <span class="text-gray-300">|</span>
      <span>{lesezeit}</span>
    </div>

    <h3 class="text-lg font-bold text-gray-900 mb-2 group-hover:text-primary-600 transition-colors line-clamp-2">
      <a href={`/blog/${slug}`} class="block">{titel}</a>
    </h3>

    <p class="text-sm text-gray-600 leading-relaxed line-clamp-3">{beschreibung}</p>

    <a href={`/blog/${slug}`} class="inline-flex items-center gap-1 mt-4 text-sm font-semibold text-primary-600 hover:text-primary-700 group-hover:gap-2 transition-all">
      Weiterlesen
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
</article>
