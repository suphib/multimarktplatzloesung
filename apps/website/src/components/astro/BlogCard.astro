---
interface Props {
  titel: string;
  beschreibung: string;
  datum: string;
  slug: string;
  lesezeit: string;
}

const { titel, beschreibung, datum, slug, lesezeit } = Astro.props;

const formatDatum = (d: string) => {
  return new Date(d).toLocaleDateString('de-DE', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};
---

<article class="group bg-white rounded-2xl border border-gray-100 overflow-hidden hover:shadow-lg hover:border-primary-200 transition-all duration-300">
  <!-- Placeholder Image -->
  <div class="aspect-[16/9] bg-gradient-to-br from-primary-50 to-primary-100 flex items-center justify-center">
    <svg class="w-12 h-12 text-primary-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
    </svg>
  </div>

  <div class="p-5 sm:p-6">
    <div class="flex items-center gap-3 text-xs text-gray-500 mb-3">
      <time datetime={datum}>{formatDatum(datum)}</time>
      <span class="text-gray-300">|</span>
      <span>{lesezeit}</span>
    </div>

    <h3 class="text-lg font-bold text-gray-900 mb-2 group-hover:text-primary-600 transition-colors">
      <a href={`/blog/${slug}`} class="block">{titel}</a>
    </h3>

    <p class="text-sm text-gray-600 leading-relaxed line-clamp-3">{beschreibung}</p>

    <a href={`/blog/${slug}`} class="inline-flex items-center gap-1 mt-4 text-sm font-semibold text-primary-600 hover:text-primary-700">
      Weiterlesen
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
</article>
